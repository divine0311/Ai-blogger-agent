# Copy this file to .env and fill in the values.

# Blogger blog ID (long number from the Blogger URL or API)
BLOG_ID=YOUR_BLOG_ID

# Google OAuth app credentials (Desktop app client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# One-time OAuth refresh token with Blogger scope
GOOGLE_REFRESH_TOKEN=

# Your portfolio URL, linked naturally inside each post
PORTFOLIO_URL=

# "draft" = save as draft (default). "live" = publish immediately.
PUBLISH_MODE=draft
